        o1_0.status,
        o1_0.subtotal,
        o1_0.tax_amount,
        o1_0.total_amount,
        t1_0.tracking_id,
        t1_0.carrier,
        t1_0.current_status,
        t1_0.estimated_delivery,
        t1_0.events,
        t1_0.order_id,
        t1_0.qr_code_data,
        t1_0.tracking_number,
        t1_0.tracking_url,
        t1_0.updated_at,
        o1_0.updated_at,
        o1_0.user_id 
    from
        orders o1_0 
    left join
        order_tracking t1_0 
            on o1_0.order_id=t1_0.order_id 
    where
        o1_0.order_id=? 
        and (
            o1_0.deleted_at IS NULL
        )
