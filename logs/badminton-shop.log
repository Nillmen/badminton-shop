        i1_0.stringing_notes,
        i1_0.stringing_service_id,
        i1_0.tension,
        i1_0.variant_id,
        c1_0.session_id,
        c1_0.updated_at,
        c1_0.user_id 
    from
        carts c1_0 
    left join
        cart_items i1_0 
            on c1_0.cart_id=i1_0.cart_id 
    where
        c1_0.session_id=?
